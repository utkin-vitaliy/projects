theme_override_font_sizes/font_size = 12
text = "ROUND 1"
horizontal_alignment = 2
vertical_alignment = 1

[node name="Separator" type="HSeparator" parent="ContentMargin/Content"]
layout_mode = 2

[node name="Roster" type="VBoxContainer" parent="ContentMargin/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="SloopRow" parent="ContentMargin/Content/Roster" instance=ExtResource("3_row")]
layout_mode = 2

[node name="FrigateRow" parent="ContentMargin/Content/Roster" instance=ExtResource("3_row")]
layout_mode = 2

[node name="GalleonRow" parent="ContentMargin/Content/Roster" instance=ExtResource("3_row")]
layout_mode = 2

[node name="DetailSeparator" type="HSeparator" parent="ContentMargin/Content"]
layout_mode = 2

[node name="ShipName" type="Label" parent="ContentMargin/Content"]
