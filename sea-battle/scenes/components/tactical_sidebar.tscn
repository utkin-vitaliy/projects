[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/tactical_sidebar.gd" id="1_sidebar"]
[ext_resource type="Theme" path="res://resources/themes/nautical_theme.tres" id="2_theme"]

[node name="TacticalSidebar" type="PanelContainer"]
layout_mode = 2
theme = ExtResource("2_theme")
script = ExtResource("1_sidebar")

[node name="ContentMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="ContentMargin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Eyebrow" type="Label" parent="ContentMargin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.663, 0.741, 0.773, 1)
theme_override_font_sizes/font_size = 12
text = "ACTIVE PLAYER"

[node name="ActivePlayer" type="Label" parent="ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.835, 0.651, 0.325, 1)
theme_override_font_sizes/font_size = 28
text = "PLAYER 1"

[node name="Separator" type="HSeparator" parent="ContentMargin/Content"]
layout_mode = 2

[node name="ShipName" type="Label" parent="ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "THE MARINER"

[node name="HullLabel" type="Label" parent="ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "3 / 3"

[node name="HullBar" type="ProgressBar" parent="ContentMargin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
max_value = 3.0
value = 3.0
show_percentage = false

[node name="Stats" type="Label" parent="ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.663, 0.741, 0.773, 1)
theme_override_font_sizes/font_size = 13
text = "MOVE 3   RANGE 2   DAMAGE 1"

[node name="ActionState" type="Label" parent="ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "MOVE READY · ATTACK READY"

[node name="Spacer" type="Control" parent="ContentMargin/Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="Message" type="Label" parent="ContentMargin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
theme_override_colors/font_color = Color(0.663, 0.741, 0.773, 1)
text = "Select your ship"
autowrap_mode = 2

[node name="EndTurn" type="Button" parent="ContentMargin/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "END TURN"
